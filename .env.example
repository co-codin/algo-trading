# Local runtime settings. Keep real secrets in .env; this example is safe to commit.
MOEX_API_KEY=
# MOEXALGO_API_KEY can be used as an alias when that name is already in your shell.
# MOEXALGO_API_KEY=
# Optional override when FUTOI uses a separate MOEX APIM key.
MOEX_FUTOI_API_KEY=

ADMIN_EMAIL=cuiyeqing960904@gmail.com
ADMIN_PASSWORD=

# Local Python uses in-memory auth unless DATABASE_URL is set.
# Docker Compose provides its own Postgres DATABASE_URL internally.
# DATABASE_URL=postgresql://algo:algo@localhost:5432/algo_trading
# Set REDIS_URL only when a Redis server and worker are running locally.
# Docker Compose provides its own Redis URL internally.
# REDIS_URL=redis://localhost:6379/0
RQ_QUEUE=maintenance
API_RESPONSE_CACHE_ENABLED=0
API_CACHE_TTL_SYMBOLS_SECONDS=30
API_CACHE_TTL_LIVE_SYMBOLS_SECONDS=300
API_CACHE_TTL_LIVE_CHART_SECONDS=10
API_CACHE_TTL_MARKET_BREADTH_SECONDS=300
API_CACHE_TTL_FUTOI_SECONDS=60
API_CACHE_TTL_FUTOI_INSTRUMENTS_SECONDS=300
# MARKET_BREADTH_DATA_DIR=historical_data/breadth
APP_LOG_DIR=logs
HISTORICAL_DATA_DIR=historical_data
HISTORICAL_CSV_RETENTION_DAYS=1095
HISTORICAL_CSV_REFRESH_SECONDS=3600
HISTORICAL_CSV_PRUNE_SECONDS=86400
MOEX_FUTOI_DATA_DIR=historical_data/futoi
MOEX_FUTOI_RETENTION_DAYS=730
MOEX_FUTOI_REFRESH_SECONDS=86400
MOEX_FUTOI_PRUNE_SECONDS=604800
MARKET_BREADTH_RETENTION_DAYS=365
