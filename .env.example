# Local runtime settings. Keep real secrets in .env; this example is safe to commit.
MOEX_API_KEY=
# MOEXALGO_API_KEY can be used as an alias when that name is already in your shell.
# MOEXALGO_API_KEY=

ADMIN_EMAIL=cuiyeqing960904@gmail.com
ADMIN_PASSWORD=Vladimir960904

# Local Python uses in-memory auth unless DATABASE_URL is set.
# Docker Compose provides its own Postgres DATABASE_URL internally.
# DATABASE_URL=postgresql://algo:algo@localhost:5432/algo_trading
# MARKET_BREADTH_DATA_DIR=historical_data/breadth
HISTORICAL_DATA_DIR=historical_data
HISTORICAL_CSV_RETENTION_DAYS=365
HISTORICAL_CSV_REFRESH_SECONDS=3600
HISTORICAL_CSV_PRUNE_SECONDS=86400
MARKET_BREADTH_RETENTION_DAYS=365
